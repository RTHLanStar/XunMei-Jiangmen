[
  {
    "start": 0.92,
    "end": 1.99,
    "text": "亲爱的你，"
  },
  {
    "start": 2.12,
    "end": 3.14,
    "text": "有些故乡，"
  },
  {
    "start": 3.2,
    "end": 4.97,
    "text": "远行之后才读懂。"
  },
  {
    "start": 5.44,
    "end": 6.93,
    "text": "让我们沿着一封信，"
  },
  {
    "start": 7.0,
    "end": 8.16,
    "text": "走进江门。"
  },
  {
    "start": 10.33,
    "end": 11.32,
    "text": "楼的远望，"
  },
  {
    "start": 11.4,
    "end": 14.15,
    "text": "是把远方的见闻砌进砖石，"
  },
  {
    "start": 14.29,
    "end": 16.63,
    "text": "把故乡的牵挂留在窗前。"
  },
  {
    "start": 20.32,
    "end": 21.99,
    "text": "屋檐接住岭南的雨，"
  },
  {
    "start": 22.11,
    "end": 24.01,
    "text": "长街留住日常的暖。"
  },
  {
    "start": 24.44,
    "end": 25.45,
    "text": "一声问候，"
  },
  {
    "start": 25.53,
    "end": 27.25,
    "text": "就是乡情的回响。"
  },
  {
    "start": 31.11,
    "end": 33.05,
    "text": "江水向远处流去，"
  },
  {
    "start": 33.16,
    "end": 34.88,
    "text": "思念沿来路回响。"
  },
  {
    "start": 35.29,
    "end": 36.84,
    "text": "水的方向是远方，"
  },
  {
    "start": 36.92,
    "end": 38.49,
    "text": "心的方向是故乡。"
  },
  {
    "start": 42.12,
    "end": 44.52,
    "text": "一瓣陈皮，收好阳光。"
  },
  {
    "start": 44.89,
    "end": 45.73,
    "text": "一双手，"
  },
  {
    "start": 45.85,
    "end": 47.42,
    "text": "把时光传下去。"
  },
  {
    "start": 47.85,
    "end": 49.34,
    "text": "敬每一份手艺，"
  },
  {
    "start": 49.45,
    "end": 50.95,
    "text": "也敬家的味道。"
  },
  {
    "start": 56.11,
    "end": 57.47,
    "text": "从世界走来，"
  },
  {
    "start": 57.53,
    "end": 58.96,
    "text": "向故乡望去。"
  },
  {
    "start": 59.4,
    "end": 60.6,
    "text": "寻美江门，"
  },
  {
    "start": 60.7,
    "end": 63.1,
    "text": "也是寻回心里的那盏灯。"
  }
]